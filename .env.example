# Copy to .env.local and fill in. Never commit .env.local.

# PostgreSQL (local install or docker compose; swap for a cloud URL later)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trustedtrainer?schema=public"

# Email via Google SMTP (use a Gmail App Password, not the account password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="TrustedtrAiner <you@gmail.com>"
LEADS_NOTIFY_EMAIL=""

# Cloudflare Turnstile. These defaults are Cloudflare's official always-pass TEST keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
